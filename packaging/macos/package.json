{
  "name": "statedu-studio-macos",
  "version": "1.3.1",
  "description": "StatEdu Studio for Apple Silicon",
  "author": "StatEdu",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir --arm64",
    "dist:dmg": "electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.statedu.studio.mac",
    "productName": "StatEdu Studio",
    "asar": true,
    "asarUnpack": [
      "package.json",
      "app/**/*",
      "runtime/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*",
      "runtime/**/*",
      "desktop-bridge.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "minimumSystemVersion": "13.0",
      "identity": null,
      "hardenedRuntime": false,
      "fileAssociations": [
        {
          "ext": "studio",
          "name": "StatEdu Studio Project",
          "role": "Editor",
          "rank": "Alternate"
        }
      ]
    },
    "afterPack": "./bundle-notices.cjs"
  }
}
